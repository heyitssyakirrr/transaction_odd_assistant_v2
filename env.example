LLM_BASE_URL=https://llm-loader-askpbai.apps.bgndevocp101.pbb.pbg.my
LLM_CHAT_PATH=/v1/chat/completions
LLM_MODEL=qwen2.5-vl-7b-instruct
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization
# Sent as the X-PBAI-Helper-Id header on every LLM request; leave blank to not send it.
HELPER_ID=
LLM_TIMEOUT_SECONDS=180
# Set this only after confirming the model's total context window with the LLM
# platform team. Zero means the application records estimates but does not
# reject large prompts before the LLM service does.
LLM_CONTEXT_WINDOW_TOKENS=0
LLM_CONTEXT_SAFETY_MARGIN_TOKENS=512
# WARNING: model output can contain transaction-derived personal data. Enable
# only for approved troubleshooting and send logs to a restricted sink.
LLM_LOG_RAW_RESPONSE_MAX_CHARS=20000
# Most LLM calls in flight at once, across all accounts. Each account sends up to 3 calls
# at once, so use BATCH_ACCOUNT_CONCURRENCY x 3 (3 accounts -> 9: 3 per pod, as one account
# sends today). Lower means accounts wait in the app; the startup log warns about it.
LLM_CONCURRENCY=9
# At most this many waiting calls are kept in memory. A full queue returns 503
# instead of allowing large or simultaneous uploads to overload the LLM service.
LLM_QUEUE_MAXSIZE=60
LLM_QUEUE_ENQUEUE_TIMEOUT_SECONDS=5
# Compatibility default. The V11 account workflow uses the two limits below.
MAX_RESPONSE_TOKENS=700

# Three focused Qwen calls per account (activity/flow, timing, profile), run concurrently
# through the existing queue. LLM_TRANSACTION_MAX_RESPONSE_TOKENS caps activity/flow and timing.
LLM_TRANSACTION_MAX_RESPONSE_TOKENS=500
# Keep cookies the LLM server sets (off: a sticky-session cookie would make calls 1-3 run one at a time).
LLM_KEEP_COOKIES=false
LLM_PROFILE_CONTEXT_MAX_RESPONSE_TOKENS=260

# The current internal loader does not enforce response_format/json_schema.
LLM_STRUCTURED_OUTPUT_PROTOCOL=off
LLM_JSON_REPAIR_ENABLED=true

# Retry once only for a complete but malformed/schema-invalid response.
# A finish_reason=length result does not retry.
LLM_FORMAT_RETRY_ENABLED=true

LLM_TEMPERATURE=0
LLM_TOP_P=0.001
LLM_REPETITION_PENALTY=0

# Must be comma-separated. Your current first separator is incorrect.
LLM_STOP_SEQUENCES=<|im_end|>,<|endoftext|>,assistant:,system:,user:
LLM_STOP_AFTER_JSON_OBJECT=true

# Output limit: field name, highest value any call may ask for (0 = no cap), and extra room
# added to every call for a reasoning model's hidden thinking (0 for Qwen).
LLM_MAX_TOKENS_PARAM=max_tokens
LLM_OUTPUT_TOKEN_CAP=700
LLM_REASONING_EXTRA_TOKENS=0
# low / medium / high for a reasoning model; blank = not sent.
LLM_REASONING_EFFORT=

# ---------------------------------------------------------------------------------------
# AI Foundry (gpt-6-luna): replace the matching lines above with these.
# LLM_CHAT_PATH=/foundry/chat/completions
# LLM_MODEL=gpt-6-luna
# LLM_TEMPERATURE=
# LLM_TOP_P=
# LLM_STOP_SEQUENCES=none
# LLM_STOP_AFTER_JSON_OBJECT=false
# LLM_OUTPUT_TOKEN_CAP=0
# LLM_REASONING_EXTRA_TOKENS=4000
# LLM_REASONING_EFFORT=
# LLM_STRUCTURED_OUTPUT_PROTOCOL=off
# LLM_TIMEOUT_SECONDS=180
# Foundry is not 3 pods: keep 9 unless the platform team gives a lower rate limit.
# LLM_CONCURRENCY=9
# ---------------------------------------------------------------------------------------
# Mount this directory on persistent storage in OpenShift. Local container
# files are lost when a pod is replaced.
REPORT_DIRECTORY=data/reports
# The model must not be treated as a final decision maker in this application.
REQUIRE_HUMAN_REVIEW=true

CUSTOMER_INFO_PARQUET_PATH=/pythonITD/dwh_312/for_Izzat/customer_info.parquet

# CSV with columns CODE, D_CUST_OCCUPAT.
OCCUPATION_CODE_CSV_PATH=/pythonITD/dwh_312/TransactionSummary/D_CUST_OCCUPAT.csv 

LOG_DIRECTORY=data/logs
LOG_RETENTION_DAYS=30
LLM_LOG_RAW_RESPONSE=true

DORMANCY_MIN_ZERO_MONTHS=3
# Every account file holds exactly this many consecutive months.
REVIEW_MONTHS=12

# "Read from folder" on the upload page: a server folder of account Parquet files, one account
# per file with the same 15 columns as the CSV. Leave blank to hide the option.
ACCOUNT_FOLDER_PATH=
# CITIZEN_CD in customer_info that means Malaysian (for the citizenship filter).
MALAYSIAN_CITIZEN_CD=MY
# The rule-based risk of the folder's accounts, for the comparison CSV only; never sent to the AI.
FOLDER_EXPECTED_RISK=high
# Where the comparison CSV of each batch is written (one row per finished account).
BATCH_RESULTS_DIRECTORY=data/batches

# Screening against each account's own usual level (compliance-owned; see app/config.py).
REVIEW_UNUSUAL_TIMES_USUAL=2
REVIEW_MIN_AMOUNT=2000
REVIEW_LAYERING_MAX_DIFFERENCE_PCT=15
REVIEW_LAYERING_TIMES_USUAL_MONTH=2

# Multi-file upload: files queue in the app and run one account at a time.
BATCH_MAX_FILES=20
BATCH_KEEP_RECENT=20
# Accounts of a batch analysed at the same time. 3 keeps all 3 LLM pods busy; 1 = one by one.
BATCH_ACCOUNT_CONCURRENCY=3
