LLM_BASE_URL=https://llm-loader-askpbai.apps.bgndevocp101.pbb.pbg.my
LLM_CHAT_PATH=/v1/chat/completions
LLM_MODEL=qwen2.5-vl-7b-instruct
LLM_API_KEY=
LLM_API_KEY_HEADER=Authorization
LLM_TIMEOUT_SECONDS=180
# Set this only after confirming the model's total context window with the LLM
# platform team. Zero means the application records estimates but does not
# reject large prompts before the LLM service does.
LLM_CONTEXT_WINDOW_TOKENS=0
LLM_CONTEXT_SAFETY_MARGIN_TOKENS=512
# WARNING: model output can contain transaction-derived personal data. Enable
# only for approved troubleshooting and send logs to a restricted sink.
LLM_LOG_RAW_RESPONSE=true
LLM_LOG_RAW_RESPONSE_MAX_CHARS=20000
# The internal Qwen service has three available slots. This limit applies to
# every LLM request in this application, including synthesis and verification.
LLM_CONCURRENCY=3
# At most this many waiting calls are kept in memory. A full queue returns 503
# instead of allowing large or simultaneous uploads to overload the LLM service.
LLM_QUEUE_MAXSIZE=60
LLM_QUEUE_ENQUEUE_TIMEOUT_SECONDS=5
# Compatibility default. The V11 account workflow uses the two limits below.
MAX_RESPONSE_TOKENS=700

# V11: two compact Qwen calls per account. They run through the existing queue.
LLM_TRANSACTION_MAX_RESPONSE_TOKENS=500
LLM_PROFILE_CONTEXT_MAX_RESPONSE_TOKENS=260

# The current internal loader does not enforce response_format/json_schema.
LLM_STRUCTURED_OUTPUT_PROTOCOL=off
LLM_JSON_REPAIR_ENABLED=true

# Retry once only for a complete but malformed/schema-invalid response.
# A finish_reason=length result does not retry.
LLM_FORMAT_RETRY_ENABLED=true

LLM_TEMPERATURE=0
LLM_TOP_P=0.001
LLM_REPETITION_PENALTY=0

# Must be comma-separated. Your current first separator is incorrect.
LLM_STOP_SEQUENCES=<|im_end|>,<|endoftext|>,assistant:,system:,user:
# Mount this directory on persistent storage in OpenShift. Local container
# files are lost when a pod is replaced.
REPORT_DIRECTORY=data/reports
# The model must not be treated as a final decision maker in this application.
REQUIRE_HUMAN_REVIEW=true

CUSTOMER_INFO_PARQUET_PATH=/pythonITD/dwh_312/for_Izzat/customer_info.parquet

# CSV with columns CODE, D_CUST_OCCUPAT.
OCCUPATION_CODE_CSV_PATH=/pythonITD/dwh_312/TransactionSummary/D_CUST_OCCUPAT.csv 
